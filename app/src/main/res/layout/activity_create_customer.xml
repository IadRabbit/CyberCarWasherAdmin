<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    tools:context=".CreateCustomerActivity">

    <TextView
        android:id="@+id/buttonBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/ripple_text_button"
        android:padding="12dp"
        android:text="‹"
        android:textColor="@color/neon_cyan"
        android:textSize="26sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.06"
        android:shadowColor="@color/neon_cyan"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="12"
        android:text="@string/create_header"
        android:textAllCaps="true"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@id/buttonBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/buttonBack" />

    <ScrollView
        android:id="@+id/groupForm"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonBack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/cardPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_panel"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:text="@string/create_label_nome"
                    android:textAllCaps="true"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/editNome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:background="@null"
                    android:fontFamily="sans-serif-medium"
                    android:inputType="textPersonName|textCapWords"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_faint"
                    android:textCursorDrawable="@null"
                    android:textSize="20sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/dashed_line" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:text="@string/create_label_cognome"
                    android:textAllCaps="true"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/editCognome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:background="@null"
                    android:fontFamily="sans-serif-medium"
                    android:inputType="textPersonName|textCapWords"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_faint"
                    android:textCursorDrawable="@null"
                    android:textSize="20sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/dashed_line" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:text="@string/create_label_saldo"
                    android:textAllCaps="true"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/editSaldo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:background="@null"
                    android:fontFamily="sans-serif-black"
                    android:hint="0"
                    android:inputType="number"
                    android:shadowColor="@color/neon_green"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="10"
                    android:textColor="@color/neon_green"
                    android:textColorHint="@color/text_faint"
                    android:textCursorDrawable="@null"
                    android:textSize="26sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/dashed_line" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:text="@string/create_label_data"
                    android:textAllCaps="true"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/textDataValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_faint"
                    android:textSize="13sp"
                    tools:text="10/09/2026" />

            </LinearLayout>

            <TextView
                android:id="@+id/textFormWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_panel"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.02"
                android:padding="14dp"
                android:text="@string/create_tag_before_write"
                android:textColor="@color/neon_red"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonWrite"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:text="@string/create_button_write"
                android:textAllCaps="true"
                android:textColor="@color/neon_cyan"
                app:cornerRadius="28dp"
                app:rippleColor="@color/neon_magenta"
                app:strokeColor="@color/neon_cyan"
                app:strokeWidth="1.5dp" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/groupWaiting"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonBack">

        <ImageView
            android:id="@+id/imageNfcWaves"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:contentDescription="@null"
            android:src="@drawable/nfc_waves" />

        <TextView
            android:id="@+id/textWaitingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.03"
            android:text="@string/create_waiting_title"
            android:textColor="@color/text_primary"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/textWaitingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:text="@string/create_waiting_subtitle"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/buttonBackToForm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/ripple_text_button"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:text="@string/create_button_back_to_form"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
