<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    tools:context=".PosActivity">

    <TextView
        android:id="@+id/buttonBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/ripple_text_button"
        android:padding="12dp"
        android:text="‹"
        android:textColor="@color/neon_cyan"
        android:textSize="26sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.06"
        android:shadowColor="@color/neon_magenta"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="12"
        android:text="@string/pos_header"
        android:textAllCaps="true"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@id/buttonBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/buttonBack" />

    <ScrollView
        android:id="@+id/groupSelection"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonBack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/pos_subtitle"
                android:textAllCaps="true"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/servicesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonConfirm"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:text="@string/pos_button_confirm"
                android:textAllCaps="true"
                android:textColor="@color/neon_magenta"
                app:cornerRadius="28dp"
                app:rippleColor="@color/neon_cyan"
                app:strokeColor="@color/neon_magenta"
                app:strokeWidth="1.5dp" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/groupWaiting"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonBack">

        <ImageView
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:contentDescription="@null"
            android:src="@drawable/nfc_waves" />

        <TextView
            android:id="@+id/textWaitingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.03"
            android:text="@string/pos_waiting_title"
            android:textColor="@color/text_primary"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/textWaitingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:text="@string/pos_waiting_subtitle"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/buttonBackToSelection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/ripple_text_button"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:text="@string/pos_button_cancel"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/groupResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_panel"
        android:orientation="vertical"
        android:padding="22dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonBack"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.35"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="28dp">

        <TextView
            android:id="@+id/textResultTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.03"
            android:textSize="20sp"
            tools:text="Pagamento completato" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/divider_glow" />

        <TextView
            android:id="@+id/textResultClient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            tools:text="Mario Rossi" />

        <TextView
            android:id="@+id/textResultService"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:fontFamily="monospace"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            tools:text="Lavaggio Completo — € 9,00" />

        <TextView
            android:id="@+id/textResultBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:textSize="24sp"
            tools:text="Nuovo saldo: € 18,50" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonResultPrimary"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:textColor="@color/neon_cyan"
            app:cornerRadius="26dp"
            app:rippleColor="@color/neon_magenta"
            app:strokeColor="@color/neon_cyan"
            app:strokeWidth="1.5dp"
            tools:text="Nuova operazione" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
